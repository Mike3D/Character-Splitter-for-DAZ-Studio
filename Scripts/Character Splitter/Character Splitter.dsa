var button_find = Button(groupbox7_2, 'Find Morph(s)');
connect(button_find, 'clicked', function() { FindMorphs(); });

function FindMorphs()
{
	// Create List View
	if (!delView)
	{
		delView = new DzListView(groupbox7_2);

		var items = ['Morph', 'Author', 'Path'];
		for (var i = 0; i < items.length; i++)
		{
			delView.addColumn(items[i]);
			delView.setColumnWidthMode(i, 0);
		}
		delView.setColumnWidth(0, 80);
		delView.setColumnWidth(1, 80);
		delView.setColumnWidth(2, 110);
	}

	delView.clear();

	// Get morph names
	var names = [morph1Name.text, morph2Name.text, morph3Name.text].filter(Boolean);
	if (names.length <= 0)
		return;

	// Get all figures (base + attachments)
	var allFigures = Array.from(attachments); // Copy
	allFigures.unshift(oNode); // Prepend with base figure
	morph_items = [];

	// Search morph names in every figures & build List View from found morphs
	for (var n = 0; n < allFigures.length; n++)
	{
		var node = allFigures[n];

		for (var i = 0; i < names.length; i++)
		{
			var name = names[i];

			var prop = helper.findControlProperty(name, node, true, true); // DzProperty
			if (!prop)
				continue;

			var to_use = helper.isNodeProperty(prop) ? prop : prop.getOwner(); // Decide whether to use prop (CTRL) or morph (Head & Body)

			var item = new DzCheckListItem(delView, DzCheckListItem.CheckBox);
			item.setText(0, name); // Name
			item.setText(1, to_use.assetAuthor.name); // Artist
			item.setText(2, to_use.assetSource.isEmpty() ? to_use.assetUri.toPath() : to_use.assetSource.toPath()); // Absolute file Path - Note: when the morph is in 'modified' state, assetUri is empty & assetSource is not empty (and vice-versa)

			item.on = true; // Checked by default

			morph_items.push([item, prop]);
		}
	}

	// Display found morphs in the List View
	if (delView.childCount > 0)
	{
		groupbox7_3.show(); // Show 'Delete Morph(s)' button
		connect(delView, 'clicked', function(item, pos, col) { if (col == 2) App.showInNativeBrowser(item.text(2)); }); // Browse to clicked morph path
	}
}

//==================
// Display 'Delete Morph(s)' button
//==================
var button_delete = Button(groupbox7_3, 'Delete Morph(s)', 'Delete Selected morph(s)');
connect(button_delete, 'clicked', function() { DeleteMorphs(); });

function DeleteMorphs()
{
	logBox.insertItem('\n================== Delete Morphs ===================');

	for (var i = 0; i < morph_items.length; i++)
	{
		var item_data = morph_items[i]; // [item, prop]
		var item = item_data[0]; // DzCheckListItem
		var prop = item_data[1]; // DzProperty

		// Skip unchecked item
		if (!item.on)
			continue;

		// Delete card
		var cardPath = FullPathChecked(prop.getPresentation().iconLarge);
		if (!cardPath.isEmpty())
		{
			var fi = new DzFileInfo(cardPath);
			fi.remove(); // Delete file
		}

		// Delete dsf file
		var fi = new DzFileInfo(item.text(2));
		if (fi.remove()) // Delete file (or empty path if unsaved)
		{
			helper.helperRemoveProperty(prop); // Delete cached property
			logBox.insertItem('\u2714 Deleted %1'.arg(item.text(2)));
		}
		else logBox.insertItem('\u2620 Failed to delete %1'.arg(item.text(2)));

		// Also remove empty directories in path
		var p = File2Path(item.text(2)); // Morph directory
		new DzDir(p).rmpath(p);
	}

	groupbox7_3.hide();
	FindMorphs(); // Display remaining/failed morphs
}

