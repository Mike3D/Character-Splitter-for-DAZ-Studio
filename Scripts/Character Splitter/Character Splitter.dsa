function DirectoryPresetClicked()
{
	// Open output directory if shift is pressed
	if (App.isKeyDown(0x01000020))
		App.showURL('file:///' + button_char_dir.text);
	else
	{
		// Open directory browser
		var file = FileDialog.doDirectoryDialog('Select Output Directory', '', button_char_dir.text, tab5); // String (full dir path)
		if (file.isEmpty()) return; // Cancelled by user
		button_char_dir.text = file;
	}
}

var charName, doMaterial, selectedCard5_1, selectedCard5_2;

//==================
// Create tab #5 (Preset) content based on whether we have a controller
//==================
function CreateTab5()
{
	var kind = ctrl.checked ? 'Characters' : 'Shaping'; // Character preset if we have a controller, Shaping presets otherwise

	tabs.setTabToolTip(5, 'Save %1 Preset(s)'.arg(kind));
	var out = FullPathChecked('Presets/' + kind); // @start, we'll use Presets/Characters or Presets/Shaping folder if available, base path otherwise
	button_char_dir.text = out.isEmpty() ? basePath : out; button_char_dir.toolTip = 'Select where to export your %1 preset(s). Press shift to open output directory'.arg(kind);

	// Character preset settings
	if (ctrl.checked)
	{
		//==================
		// Display Character 'Name' line edit
		//==================
		var groupbox5_1 = VGroupBox(tab5, 'Character Preset');
		var layout5_1 = new DzGridLayout(groupbox5_1);
		charName = LabelledLineEdit(groupbox5_1, layout5_1, 0, 'Name', 30, 'Character Name'); charName.text = product.text; // Infer character name from product name

		//==================
		// Display 'Material Settings' checkbox
		//==================
		doMaterial = CheckBox(groupbox5_1, 'Material Settings', true, 'Whether to include material settings');

		//==================
		// Display 2 Character 'Card Image' buttons for file browser / file path line edit
		//==================
		var groupbox5_3 = new DzHGroupBox(tab5);
		selectedCard5_1 = CardSelect(groupbox5_3, 256, 256);
		selectedCard5_2 = CardSelect(groupbox5_3, 91, 91);
	}

	//==================
	// Display 'Save Character Preset' or 'Save Shaping Preset' button
	//==================
	var button_character = Button(tab5, 'Save %1 Preset'.arg(kind));
	if (ctrl.checked)
		connect(button_character, 'clicked', function() { CreateCharacter(); });
	else connect(button_character, 'clicked', function() { CreateShapingPresets(); });
}

//==================
// Create character preset (silently)
//==================
function CreateCharacter()
{
	// Check for empty fields
	if (charName.text.isEmpty())
	{
		ErrorDialog([['Character Name', 'Character']], 'Mandatory Fields Left Empty', ['Field', 'Tab']);
		return;
	}

	// Show Log Report (tab #6)
	tabs.setCurrentWidget(tab6);

	logBox.insertItem('\n============== Character Preset ==============');

	var classFilter = assetIOMgr.findFilter('DzCharacterAssetFilter');
	var filter = assetIOMgr.getFilter(classFilter); // DzAssetIOFilter

	// Dial-in the Head & Body morphs using the controller - Note: head-related morphs (eyelashes...) are driven by the head morph
	GetController().setValue(1);

	// Delete D-Former (no longer needed & we don't want to save it in our preset)
	if (deformer.getZone())
		Scene.removeNode(deformer.getZone());
	if (deformer.getBase())
		Scene.removeNode(deformer.getBase());

	// Settings
	var settings = new DzFileIOSettings();
	filter.getDefaultOptions(settings); // Default settings
	settings.setBoolValue('WriteShapes', true);
	settings.setBoolValue('WriteMaterials', doMaterial.checked);
	settings.setBoolValue('CompressOutput', compress.checked);
	settings.setBoolValue('RunSilent', true);

	// Post Load settings for attachments (eyelashes, tear, mouth, eyes & eyebrows) - TODO: should probably be automatic (left for later investigation)
	var file = new DzFile('%1/%2.json'.arg(scriptPath).arg(figName));
	if (file.open (DzFile.ReadOnly)) // Get settings from json file for the figure
	{
		settings.setBoolValue('PostLoadEnable', true);
		var subSettings = new DzSettings();
		subSettings.fromString(file.read());
		settings.setStringValue('PostLoadScriptPath', subSettings.getStringValue('PostLoadScriptPath'));
		settings.setSettingsValue('PostLoadScriptSettings', subSettings.getSettingsValue('PostLoadScriptSettings'));
	}
	else logBox.insertItem('\u2620 Failed to load Post Load settings ' + file.fileName());

	// Save character preset to dsf file
	var file = '%1/%2'.arg(button_char_dir.text).arg(charName.text);
	var error = assetIOMgr.doSaveWithOptions(filter, settings, false, file, button_char_dir.text);
	logBox.insertItem(error.valueOf() === 0x00000000 ? '\u2714 Character %1 created'.arg(charName.text) : '\u2620 Failed to create character (%1)'.arg(getErrorMessage(error)));

	filter.deleteLater();

	CopyCards2();

	trigger_action('DzRestoreFigureAction'); // Restore figure
}

//=========================
// Copy cards to Character folder
//=========================
function CopyCards2()
{
	var cards = [selectedCard5_1.toolTip, selectedCard5_2.toolTip];
	var names = [charName.text + '.tip.png', charName.text + '.png'];
	var dir = new DzDir(button_char_dir.text); // Go inside dir

	// Delete existing cards (including those created by assetIOMgr.doSaveWithOptions()) if they need to be replaced
	var oldCards = dir.entryList('%1*.png'.arg(charName.text)); // _.duf.png, _.png, _.tip.png
	if (!cards[0].isEmpty() && oldCards.indexOf(names[0]) > -1)
		dir.remove(names[0]);
	if (!cards[1].isEmpty() && oldCards.indexOf('%1.duf.png'.arg(charName.text)) > -1)
	{
		dir.remove('%1.duf.png'.arg(charName.text));
		dir.remove(names[1]);
	}

	// Copy image files to Character folder
	for (var i = 0; i < cards.length; i++)
	{
		var card = cards[i];
		if (card.isEmpty())
			continue;

		// Copy card
		var name = names[i];
		var file = new DzFile(card);
		var success = file.copy('%1/%2'.arg(button_char_dir.text).arg(name));
		logBox.insertItem(success ? '\u2714 Card Image %1 copied'.arg(name) : '\u2620 Failed to copy Card Image %1'.arg(name));
	}
}

//==================
// Create shaping preset(s) (silently)
//==================
function CreateShapingPresets()
{
	// Show Log Report (tab #6)
	tabs.setCurrentWidget(tab6);

	logBox.insertItem('\n============== Shaping Preset(s) ==============');

	var classFilter = assetIOMgr.findFilter('DzShapingAssetFilter');
	var filter = assetIOMgr.getFilter(classFilter); // DzAssetIOFilter

	// Settings
	var settings = new DzFileIOSettings();
	filter.getDefaultOptions(settings); // Default settings
	settings.setBoolValue('SaveCurFrame', true); // Current Frame Only
	settings.setBoolValue('CompressOutput', compress.checked);
	settings.setBoolValue('RunSilent', true);
	var subSetting = settings.setSettingsValue('NodeNames');

	// Dial-in the Head & Body morphs then save - Note: head-related morphs (eyelashes...) are driven by the head morph
	for (var i = 0; i < 2; i++) // Iterate morphs (DzFloatProperty)
	{
		morphs[i].setValue(1);
		var mLabel = morphs[i].getLabel(); // Morph label
		subSetting.setSettingsValue(oNode.getName()).setStringValue('0', mLabel);

		// Save shaping preset to dsf file
		var file = '%1/%2'.arg(button_char_dir.text).arg(mLabel);
		var error = assetIOMgr.doSaveWithOptions(filter, settings, false, file);
		logBox.insertItem(error.valueOf() === 0x00000000 ? '\u2714 Shaping preset %1 created'.arg(mLabel) : '\u2620 Failed to create %1 shaping preset (%1)'.arg(mLabel).arg(getErrorMessage(error)));

		trigger_action('DzRestoreFigureAction'); // Restore figure
	}

	filter.deleteLater();
}

//===========================================  Splitting Process  ========================================

// Find D-Former and throw a warning on issue
var deformerIssue = FindDFormer();

//=========================
// Copy cards to Product folder (Morphs/vendor/product)
//=========================
function CopyCards()
{
	var cards = [selectedCard.toolTip, selectedCard2.toolTip, selectedCard3.toolTip];
	var names = [morphName.text, morphName2.text, ctrl_name.text];

	// Copy image files to product folder
	for (var i = 0; i < cards.length; i++)
	{
		var card = cards[i];
		if (card.isEmpty())
			continue;
		var file = new DzFile(card);
		var name = names[i];
		var prop = helper.findControlProperty(name, oNode, true, true);
		var icon = prop.getPresentation().iconLarge;
		var success = file.copy('%1/%2'.arg(basePath).arg(icon));
		logBox.insertItem(success ? '\u2714 Card Image %1 copied'.arg(name) : '\u2620 Failed to copy Card Image %1'.arg(name));
	}
}

//=========================
// Execute DzAction for supplied class name
//=========================
function trigger_action(className)
{
	if (!actionMgr) return;

	// Find the action to perform
	var action = actionMgr.findAction(className);
	if (!action)
	{
		MessageBox.critical('Action %1 could not be found'.arg(action.text), 'Error', '', '');
		return;
	}

	// If the action is disabled
	if (!action.enabled)
	{
		MessageBox.critical('Action %1 is currently disabled'.arg(action.text), 'Error', '', '');
		return;
	}

	// Trigger action
	action.trigger();
}

//=========================
// Get product directory (eg. data/DAZ 3D/Genesis 8/Female/Morphs/DAZ 3D/Victoria 8)
//=========================
function GetProductDir(node)
{
	var uri = File2Path(node.assetUri.filePath.substring(1)); // data/DAZ 3D/Genesis 8/Female
	return '%1/Morphs/%2/%3'.arg(uri).arg(vendor.text).arg(product.text);
}

//=========================
// Create Presentation for Head & Body morphs & controller
//=========================
function SetPresentation(node, prop, name)
{
	var present = new DzPresentation();
	present.type = 'Modifier/Shape';
	if (node.isRootNode())
	{
		present.iconLarge = '%1/%2.png'.arg(GetProductDir(node)).arg(name); // Card - Note: not mandatory, but at this point png files are not copied & won't show up once copied
		present.colorA = colorA.value;
		present.colorB = colorB.value;
	}
	prop.setPresentation(present);
}

//=========================
// Tweak morphs & controller (DzFloatProperty) & set presentation
//=========================
function TweakProperty(prop, node, mLabel, mName, isCtrl)
{
	prop.setLabel(mLabel);
	prop.setIsClamped(true); // Use Limits
	prop.setDisplayAsPercent(true); // As Percent
	prop.setCanAutoFollow(!isCtrl); // True for Morphs - False for controller
	prop.setMinMax(0, 1);
	if (isCtrl)
		prop.setSensitivity(0.04); // Nudge (default is 0.01)

	SetPresentation(node, prop, mName);
}

//=========================
// Create controller property for applying both (scaled) morphs
//=========================
function CreateCTRL()
{
	// Create a new property
	var name = ctrl_name.text;
	var prop = new DzFloatProperty(name, true, true); // 3rd parameter (isUserProperty) is set to true to make it deletable by user

	TweakProperty(prop, oNode, ctrl_label.text, name, true);

	// Add property to oNode
	var error = oNode.addProperty(prop);
	if (error.valueOf() !== 0x00000000)
	{
		logBox.insertItem('\u2620 %1  |  Error while adding controller to node : %2'.arg(name).arg(getErrorMessage(error)));
		return;
	}

	// Set path & region - Note: must be called once property has been added to oNode
	helper.setPropertyPath(prop, ctrl_path.text);

	logBox.insertItem('\u2714 %1  |  Created (controller)'.arg(name));

	// Dial-in the Head & Body morphs
	for (var i = 0; i < 2; i++) // Iterate morphs (DzProperty)
		morphs[i].setValue(1);

	// Apply custom scale
	var mat = new DzMatrix3(true);
	mat.scale(scale.value); // Custom scale

	// Restore initial figure scale
	if (normalize.checked)
		mat = scaleMat.inverse().multiply(mat);

	if (normalize.checked || scale.value !== 1) // If figure needs to be scaled
	{
		beginUndo(); // Begin undo hold
			oNode.setWSScale(mat);
			oNode.update();
		acceptUndo('Restore initial figure scale');
	}

	// ERC Freeze the 2 (scaled) morphs
	ERCFreeze(prop, name, oNode);

	// Save CTRL property as a morph asset
	WriteMorph(oNode, name);
}

//=========================
// Collect neck bone, bone names & head bone names to allow skeleton pruning when Rigging To Shape
//=========================
var boneNames = []; // All figure bone names
var neck; // DzNode
var headNames = []; // Neck + Head bones name

function GetNeckAndBones()
{
	var bones = oNode.getNodeChildren(true);

	// Find Neck bone (named differently for each generation, split starting from G3, always containing 'neck', so we search the root bone name containing 'neck')
	for (var i = 0; i < bones.length; i++)
	{
		var n = bones[i].name; // Bone name
		boneNames.push(n);

		// Neck found
		if (!neck && n.indexOf('neck') >= 0)
		{
			neck = bones[i];

			// Get root neck when split
			while (neck.getNodeParent().name.indexOf('neck') >= 0)
				neck = neck.getNodeParent();
		}
	}

	if (!neck)
	{
		logBox.insertItem('\u2620 Neck bone not found');
		return;
	}

	// Get head bones name
	var children = neck.getNodeChildren(true);
	headNames.push(neck.name);

	for (var i = 0; i < children.length; i++) // Iterate neck children
		headNames.push(children[i].name); // Store node name
}

GetNeckAndBones();

//=========================
// Return array of bone names to exclude from Rigging To Shape (body bones for head morphs & head bones for body morph)
//=========================
function GetBonesToExclude(name)
{
	if (neck === null)
		return [];

	return morphName2.text === name ? headNames : boneNames.filter(function(n) { return headNames.indexOf(n) < 0; }); // Body morph => exclude head bones (including neck) | Head or head attachment morph => exclude body bones
}

//=========================
// Adjust rigging to shape (silently)
//=========================
function AdjustRiggingToShape(name, node)
{
	// Create & set
	var adjuster = new DzShapeRiggingAdjuster();
	adjuster.setFigure(node);
	if (doSplit.checked)
		adjuster.setExcludedBones(GetBonesToExclude(name));
	adjuster.setAdjustCenterPoints(true);
	adjuster.setAdjustEndPoints(true);
	adjuster.setAdjustOrientation(false);

	// Execute
	beginUndo(); // Begin undo hold
		var success = adjuster.doAdjustments();
		var label = node.isRootNode() ? name : node.getLabel();
		logBox.insertItem(success ? '\u2714 %1  |  Rigging adjusted to shape'.arg(label) : '\u2620 %1  |  Failed to adjust rigging to shape'.arg(label));
	acceptUndo('Adjust Rigging To Shape - %1'.arg(name)); // Finish undo hold
}

//=========================
// ERC Freeze (silently)
//=========================
function ERCFreeze(prop, name, node)
{
	// 'Control Property Selection'
	var freezer = new DzERCFreeze();
	freezer.setControllerNode(node);
	freezer.setControllerProperty(prop);

	// Build the list of nodes with properties to freeze
	var nodes = node.inherits('DzSkeleton') ? [node].concat(node.getAllBones()) : [node];

	// Also include non-morphed head attachments, we'll freeze their transforms (local position, rotation & scale)
	if (morphName.text === name)
	{
		var nonMorphed = attachments.filter(function(x) { return selection.indexOf(x) < 0; });
		for (var i = 0; i < nonMorphed.length; i++)
			nodes.push(nonMorphed[i]);
	}

	for (var i = 0; i < nodes.length; i++) // Iterate over the nodes
		freezer.addPropertiesToFreeze(nodes[i]); // Add the node's properties

	// Discard insignificant values (below 0.001 threshold)
	var props = freezer.getPropertiesToFreeze();
	var newProps = [];

	for (var i = 0; i < props.length; i++)
	{
		var p = props[i];

		if (Math.abs(p.getValue()) > 0.001) // Discard insignificant values
			newProps.push(p);
	}
	freezer.setPropertiesToFreeze(newProps);

	// 'Keyed (Extract from Play Range)'
	freezer.setKeyed(false);

	// 'Additional Options' when the freeze is complete
	freezer.setRestoreFigure(true);
	freezer.setApplyController(true);
	freezer.setRestoreRigging(true);

	// Execute
	beginUndo(); // Begin undo hold
		var success = freezer.doFreeze();
		var label = node.isRootNode() ? name : node.getLabel();
		logBox.insertItem(success ? '\u2714 %1  |  ERC freezed'.arg(label) : '\u2620 %1  |  ERC freeze failure'.arg(label));
	acceptUndo('ERC Freeze - %1'.arg(name)); // Finish undo hold
}

//=========================
// Save morph to dsf file
//=========================
function WriteMorph(node, mName)
{
	var classFilter = assetIOMgr.findFilter('DzMorphSupportAssetFilter');
	var filter = assetIOMgr.getFilter(classFilter); // DzAssetIOFilter

	// Settings
	var settings = new DzFileIOSettings();
	filter.getDefaultOptions(settings); // Default settings
	settings.setStringValue('RootLabel', node.getLabel());
	settings.setStringValue('BaseDataPath', basePath); // Absolute path to Content Library for the selected figure
	settings.setStringValue('VendorName', vendor.text);
	settings.setStringValue('ProductName', product.text);
	settings.setBoolValue('CompressOutput', compress.checked);
	settings.setBoolValue('RunSilent', true);
	var subSetting = settings.setSettingsValue('NodeNames');
	subSetting.setSettingsValue(node.getName()).setStringValue('0', mName);

	// Save morph to dsf file
	var error = assetIOMgr.doSaveWithOptions(filter, settings);
	var label = node.isRootNode() ? mName : node.getLabel();
	logBox.insertItem(error.valueOf() === 0x00000000 ? '\u2714 %1  |  Saved to file'.arg(label) : '\u2620 %1  |  Error while writing to file : %2'.arg(label).arg(getErrorMessage(error)));
	filter.deleteLater();
}

//=========================
// Create deltas for head attachments (eyelashes, eyes, mouth, tear & eyebrows)
//=========================
function CreateOtherDeltas(node)
{
	// Refresh scaled geometry in 'normalized' mode
	if (normalize.checked)
		node.update();

	var srcFig = node.getObject().getCurrentShape().getGeometry(); // Base geometry
	var tgtFig = node.getObject().getCachedGeom(); // Morphed geometry

	var deltas = new DzMorphDeltas();

	for (var i = 0; i < srcFig.getNumVertices(); i++) // Iterate src vertices
	{
		var v1 = srcFig.getVertex(i); // Base vertex
		var v2 = tgtFig.getVertex(i); // Morphed & transformed vertex

		// Apply Y offset - Note: in 'normalized' mode, we've already removed the offset (offset = 0)
		if (doSplit.checked && !normalize.checked)
			v2.y -= offset;

		// Store delta
		var delta = v2.subtract(v1);
		deltas.addDelta(i, delta);
	}

	return deltas;
}

//=========================
// Create weighted deltas
//=========================
function CreateDeltas(invert)
{
	var deltas = new DzMorphDeltas();

	for (var i = 0; i < src.getNumVertices(); i++) // Iterate src vertices
	{
		var v1 = src.getVertex(i); // Base vertex
		var v2 = tgt.getVertex(i); // Morphed & transformed vertex

		if (weights) // D-Former weight for this vertex
		{
			var wgt = weights.getFloatWeight(i);

			if (invert)
				wgt = 1 - wgt;

			if (wgt === 0) continue; // Skip unweighted vertex
		}

		// Apply Y offset - Note: in 'normalized' mode, we've already removed the offset (offset = 0)
		if (doSplit.checked && !normalize.checked)
			v2.y -= offset;

		// Apply D-Former weight to delta => weighted delta
		var delta = v2.subtract(v1);
		if (weights) // Apply D-Former weights to delta
			delta = delta.multiply(new DzVec3(wgt, wgt, wgt));

		deltas.addDelta(i, delta);
	}

	return deltas;
}

//=========================
// Create morph
//=========================
function CreateMorph(node, deltas, mLabel, mName, mPath)
{
	var mod = new DzMorph(deltas);
	mod.setName(mName);

	var error = node.getObject().addModifier(mod);
	if (error.valueOf() !== 0x00000000)
	{
		logBox.insertItem('\u2620 %1  |  Error while adding morph to node : %2'.arg(mName).arg(getErrorMessage(error)));
		return;
	}

	var prop = mod.getValueChannel(); // DzFloatProperty

	if (prop !== null)
	{
		TweakProperty(prop, node, mLabel, mName, false);

		helper.setPropertyPath(prop, mPath.text); // Set path & region - Note: must be called once property has been added to oNode

		morphs.push(prop); // Store morph (waiting for batch post-processing)
		logBox.insertItem('\u2714 %1  |  Created (%2 deltas)'.arg(node.isRootNode() ? mName : node.name).arg(deltas.getNumDeltas()));
	}
	else
		logBox.insertItem('\u2620 %1  |  Failed to create morph'.arg(mName));
}

//=========================
// Create deltas & morph
//=========================
function CreateDeltasMorph(node, invert, mLabel, mName, mPath)
{
	// Create weighted deltas
	var deltas = node.isRootNode() ? CreateDeltas(invert) : CreateOtherDeltas(node);

	// Create morph
	CreateMorph(node, deltas, mLabel, mName, mPath);
}

//=========================================  Setup Validation  =========================================

//=========================
// Find D-Former, get weights and report issues
//=========================

function GetDFormer()
{
	var nodes = oNode.getNodeChildren(true);
	for (var i = 0; i < nodes.length; i++) // Iterate object nodes
	{
		var n = nodes[i];
		if (n.inherits('DzDForm'))
		{
			deformer = n;
			break;
		}
	}
}

function FindDFormer()
{
	var issue = '';

	GetDFormer(); // Get (potentially) already applied D-Former

	// No D-Former found, try to apply relevant one in Scripts/Character Splitter folder
	if (!deformer)
	{
		var uri = new DzUri('/Scripts/Character Splitter/%1.duf'.arg(figName.replace('_1', ''))); // '_1' deletion is for G8.1
		if (contentMgr.openUri(uri))
			GetDFormer(); // Get applied D-Former
	}

	if (!deformer)
		issue = 'No D-Former found. If you are using a custom figure, ensure that your D-Former is visible in the Content Library pane (if you cannot see it, it is at the wrong place) & named as your figure';
	else if (deformer.getNumModifiers() === 0)
		issue = 'No Modifier found for D-Former';
	else
	{
		logBox.insertItem('\u2714 Using D-Former %1 (%2)'.arg(deformer.name).arg(figName));

		// Get D-Former weights
		weights = deformer.getModifier(0).getInfluenceWeights();
		if (!weights)
			issue = 'D-Former has no weights';

		// Check matching number of vertices with base figure
		var geom = oNode.getObject().getCurrentShape().getGeometry();
		var numWeights = weights.getNumWeights();
		var numVerts = geom.getNumVertices();
		if (numWeights === numVerts)
		{
			// D-Former OK, get Reference Vertex
			var lowestY = Number.MAX_VALUE;
			var refVert = 0;

			for (var i = 0; i < geom.getNumVertices(); i++) // Iterate vertices
			{
				var wgt = weights.getFloatWeight(i);

				// Reference Vertex is neither on head (weight=1) nore on body (weight=0)
				if (wgt === 0 || wgt === 1)
					continue;

				var v = geom.getVertex(i); // DzVec3

				// Reference Vertex is on the central edge loop and on front
				if (v.x === 0 && v.z > 0)
				{
					if (v.y < lowestY)
					{
						refVert = i;
						lowestY = v.y;
					}
				}
			}
			refVertex.text = refVert;

			refVertex.setIntValidator(0, numVerts - 1); // Set upper limit in case user wants to override reference vertex
		}
		else issue = "D-Former vertices (%1) don't match base figure (%2)".arg(numWeights).arg(numVerts);
	}

	if (!issue.isEmpty())
		MessageBox.critical('\n%1   '.arg(issue), '\u2620D-Former Issue', 'OK', '');
}

//=========================
// Check for missing mandatory fields & spawn error dialog or continue accordingly
//=========================
function ValidateSetup()
{
	var errors = [];

	// Check for empty fields
	if (morphName.text.isEmpty())
		errors.push(['Morph Name', 'Head']);

	if (morphLabel.text.isEmpty())
		errors.push(['Morph Label', 'Head']);

	if (doSplit.checked)
	{
		if (morphName2.text.isEmpty())
			errors.push(['Morph Name', 'Body']);

		if (morphLabel2.text.isEmpty())
			errors.push(['Morph Label', 'Body']);
	}

	if (refVertex.text.isEmpty() && (doSplit.checked || (!doSplit.checked && normalize.checked)))
		errors.push(['Reference Vertex', 'Body']);

	if (ctrl.checked && doSplit.checked)
	{
		if (ctrl_name.text.isEmpty())
		errors.push(['Controller Name', 'CTRL']);

		if (ctrl_label.text.isEmpty())
		errors.push(['Controller Label', 'CTRL']);
	}

	if (vendor.text.isEmpty())
		errors.push(['Vendor', 'Settings']);

	if (product.text.isEmpty())
		errors.push(['Product', 'Settings']);

	// Spawn error dialog
	if (errors.length > 0)
	{
		ErrorDialog(errors, 'Mandatory Fields Left Empty', ['Field', 'Tab']);
		return;
	}

	// Setup validated, let's go
	try { Execute(); }
	catch(err)
	{
		MessageBox.critical('Runtime Error: ' + err.message, 'Fatal Error', 'Exit');
		finishProgress();
	}
}

//=========================================  Main function  =========================================

function Execute()
{
	logBox.insertItem('\n=================== Save Morphs ===================');

	morphs = [];

	// Show Log Report (tab #6)
	tabs.setCurrentWidget(tab6);

	// Start progress
	startProgress('Starting process', 1, true, true); // 1 step, cancellable, show time

	// Collect attachment figures to process (Eyelashes, Mouth, Eyes, Tear, Eyebrow Cards)
	selection = attachments.filter(function(fig) { return attachmentsLV.findItem(fig.getLabel(), 0).on; }); // Selected attachment figures (from Head tab list view)

	// Set resolution to 'Base' & 'SubD' to 0 for each figure
	for (var i = 0; i < selection.length; i++)
	{
		var reso = selection[i].getPropertyGroups().getFirstChild(); // .findChild('General/Mesh Resolution')
		var resoLevel = helper.findPropertyInGroup('lodlevel', reso, true, true);
		resoLevel.setValue(0);
		var subD = helper.findPropertyInGroup('SubDIALevel', reso, true, true);
		subD.setValue(0);
	}

	// Get Base & Morphed geometries
	src = oNode.getObject().getCurrentShape().getGeometry(); // Base geometry
	tgt = oNode.getObject().getCachedGeom(); // Morphed geometry

	// Translate or scale figure based on reference vertex Y
	if (doSplit.checked || (!doSplit.checked && normalize.checked))
	{
		var rv1 = src.getVertex(parseInt(refVertex.text)).y; // Base vertex
		var rv2 = tgt.getVertex(parseInt(refVertex.text)).y; // Morphed vertex

		if (normalize.checked) // 'Normalized' mode
		{
			scaleMat = new DzMatrix3(true);
			scaleMat.scale(rv1 / rv2); // New scale based on offset

			beginUndo(); // Begin undo hold
				oNode.setWSScale(oNode.getWSScale().multiply(scaleMat)); // Apply offset to initial scale
				oNode.update(); // Note: head attachments will be updated in CreateOtherDeltas()
			acceptUndo('Normalize'); // Finish undo hold

			tgt = oNode.getObject().getCachedGeom(); // Update morphed geometry with scale applied
		}
		else offset = rv2 - rv1; // 'WYSIWYG' mode
	}

	// Don't use weights if not splitting
	if (!doSplit.checked)
		weights = null;

	// Create morphs for base figure
	CreateDeltasMorph(oNode, false, morphLabel.text, morphName.text, morph_path); // Head morph

	if (doSplit.checked)
		CreateDeltasMorph(oNode, true, morphLabel2.text, morphName2.text, morph_path2); // Body morph

	// Create morphs for head attachment figures (eyelashes, eyes, tear, mouth, eyebrows)
	for (var i = 0; i < selection.length; i++)
		CreateDeltasMorph(selection[i], false, morphLabel.text, morphName.text, morph_path); // Note: Head part name = Head name, so all attachments are driven by the head morph (all at once)

	// Finalize morph creation & save as morph asset
	for (var i = 0; i < morphs.length; i++) // Iterate morphs
	{
		var prop = morphs[i]; // DzProperty
		var morph = prop.getOwner();

		var node = morph.getElementParent().getElementParent(); // Morph node (morph < object < node)

		// Restore figure
		trigger_action('DzRestoreFigureAction');

		// Dial morph in
		if (node.isRootNode()) // Head/Body morph - Note: Head attachments (morph & skel) are driven by Head morph
		{
			prop.setValue(1);

			// For WYSIWYG body morph : restore initial figure position & Apply offset to root bone (hip) - Note: in normalized mode, we've removed the offset (offset = 0)
			if (morph.name === morphName2.text && !normalize.checked)
			{
				var root = oNode.getAllBones()[0];
				var pos = root.getWSPos();
				root.setWSPos(pos.add(new DzVec3(0, offset, 0)));
			}

			// Adjust rigging to shape
			AdjustRiggingToShape(morph.name, node);

			// ERC Freeze
			ERCFreeze(prop, morph.name, node);
		}

		// Save as morph asset
		WriteMorph(node, morph.name);
	}

	if (doSplit.checked && ctrl.checked)
		CreateCTRL(); // Create controller

	trigger_action('DzRestoreFigureAction'); // Restore figure

	CopyCards();

	finishProgress();

	// Enable morph sliders & Character tab
	if (morphs.length > 0) groupbox1_2.show();
	if (doSplit.checked) groupbox2_2.show();
	if (doSplit.checked && ctrl.checked) groupbox3_2.show();
	if (!tabs.isTabEnabled(5))
		CreateTab5(); // Customize tab #5 content (character or shaping preset)
	tabs.setTabEnabled(5, true); // Enable tab #5 ('Character')

	MessageBox.information('Done !', 'Execute()', 'OK');
}

//============================================= Run the script =============================================

window.exec(); })(); }

catch(err)
{
	// Ensure that MessageBox is available (requires 'Customize Interface' plugin)
	if (typeof MessageBox === 'undefined')
		print("[FATAL ERROR] To use Character Splitter the 'Customize Interface' plugin must be enabled");

	// Note: if MessageBox is not available, call to MessageBox below triggers an error inviting the user to check his log
	MessageBox.critical('Runtime Error: ' + err.message, 'Fatal Error', 'Exit');
}