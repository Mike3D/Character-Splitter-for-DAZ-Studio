var attachments = GetAttachments(); // Attachment figures ([DzFigure])
var attachmentsLV; // DzListView
var deformer; // DzDForm
var src; // DzVertexMesh
var tgt; // DzVertexMesh
var scaleMat; // DzMatrix3
var morphs = []; // [DzFloatProperty]
var offset = 0; // float
var weights; // DzWeightMap
var delView; // DzListView
var morph_items = []; // [DzCheckListItem, DzFloatProperty]
var pathDialog; //Path Browser dialog for Head, Body & CTRL tabs (DzBasicDialog)
var treeView; // Tree View for path browser (DzListView)
