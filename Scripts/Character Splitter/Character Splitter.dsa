try { (function() {

var actionMgr = MainWindow.getActionMgr(); // DzActionMgr
var assetIOMgr = App.getAssetIOMgr(); // DzAssetIOMgr
var assetMgr = App.getAssetMgr(); // DzAssetMgr
var contentMgr = App.getContentMgr(); // DzContentMgr
var helper = new DzSceneHelper();

var scriptPath = new DzFileInfo(getScriptFileName()).path(); // Path to this file

function FullPathChecked(str) { return str.isEmpty() ? '' : contentMgr.getAbsolutePath(DzContentMgr.NativeDirs, str); } // Return full path from relative path if path exists, empty string otherwise

function File2Path(str) { return str.match(/(.*)[\/\\]/)[1]||''; } // Return path with filename and extension stripped

//=========================================  User Config Validation (Plugins)  =========================================

//=========================
// On startup, ensure that all mandatory plugins are there & ready to use
//=========================
function CheckPlugins()
{
	var errors = [];

	var plugins = ['Asset Save Filters', 'Customize Interface', 'Default Save Filters', 'Joint Editor Tool', 'Property Hierarchy Pane']; // Mandatory plugins
	for (var i = 0; i < plugins.length; i++)
	{
		var name = plugins[i];
		var p = App.getPluginMgr().findPlugin(name);

		// Missing plugin
		if (p == null)
			errors.push([name, 'Missing']);

		// Plugin not loaded
		else if (p.getStatus() !== 0) // Status 0 = Loaded
			errors.push([name, p.getStatusString()]);
	}

	// Spawn error dialog
	if (errors.length > 0)
	{
		ErrorDialog(errors, 'Mandatory Plugins Issues', ['Plugin', 'Issue']);
		return true;
	}
	return false;
}

//=========================
// Spawn error dialog when there are some mandatory plugins issues or when setup is incomplete (missing fields)
//=========================
function ErrorDialog(errors, title, items)
{
	// Create a dialog
	var dlg = new DzDialog();
	dlg.caption = '\u2620\u2620';
	dlg.minWidth = 195; dlg.minHeight = 215;

	var dlgGB = new DzVGroupBox(dlg);

	if (errors.length > 0)
	{
		var gbox = VGroupBox(dlgGB, title);

		var errorsLV = new DzListView(gbox);

		for (var i = 0; i < items.length; i++)
		{
			errorsLV.addColumn(items[i]);
			errorsLV.setColumnWidthMode(i, 0);
		}
		errorsLV.setColumnWidth(0, 130);
		errorsLV.setColumnWidth(1, 45);
		errorsLV.setColumnWidthMode(0, 1); // Expand column #1 automatically
		errorsLV.setColumnWidthMode(1, 1); // Expand column #2 automatically
		errorsLV.allColumnsShowFocus = true;
		errorsLV.sortColumn = 1;

		for (var i = 0; i < errors.length; i++)
		{
			var e = errors[i]; // [Field ; Tab]

			errors[i] = new DzListViewItem(errorsLV, i);
			errors[i].setText(0, e[0]); // Field
			errors[i].setText(1, e[1]); // Tab
		}
	}

	// Spawn the dialog & wait
	processEvents();
	dlg.exec();
}

// Perform the check. On issues, report errors & display the 'About Installed Plugins' dialog on exit
if (CheckPlugins())
{
	App.getPluginMgr().doAboutPluginsDlg();
	return;
}

//=========================================  User config OK, let's go  =========================================

//=========================
// Create symlinks or duplicates for D-Formers supplied by DAZ in 'Developper Kit' folders
//=========================
function CreateSymlinks()
{
	var kits = ['People/Genesis 8 Female/Developer Kit/Genesis 8 Female HeadSplit DFormer.duf', 'People/Genesis 8 Male/Developer Kit/Genesis 8 Male HeadSplit DFormer.duf', 'People/Genesis 9/Developer Kit/G9 HeadSplit DFormer.duf'];
	var figNames = ['Genesis8Female', 'Genesis8Male', 'Genesis9']; // Figure name for each D-Former preset in 'Developper Kit' folder above

	var dstFiles = [];
	var srcFiles = [];

	// Check symlinks to create : requires that D-Former exists (depends on installed figures) & has no symlink (no overwrite)
	for (var i = 0; i < figNames.length; i++)
	{
		var dfp = '%1/%2.duf'.arg(scriptPath).arg(figNames[i]); // Destination file path in 'Scripts/Character Splitter' folder
		var dst = new DzFile(dfp);
		if (!dst.exists()) // No symlink, check for D-Former existence
		{
			var sfp = FullPathChecked(kits[i]); // Source file path
			if (!sfp.isEmpty()) // D-Former exists & has no symlink => create one
			{
				dstFiles.push(dfp);
				srcFiles.push(sfp);
			}
		}
	}

	if (dstFiles.length === 0) // All symlinks already created => exit
		return;

	if (App.platform() === App.Windows) // On Windows, create symlinks from the shell or duplicate files depending on user input
	{
		var choice = MessageBox.question('You are seeing this message because you are running Character Splitter for the first time, or you have installed a new DAZ figure since your last use of Character Splitter. \n\nWe need to retrieve Daz D-Formers supplied in Developper Kit of each figure.\n\nWe can either create symbolic links (administrator privileges required for this), or duplicate the files', 'Daz D-Formers retrieval', 'Duplicate Files', 'Create Symlinks');

		if (choice === 1) // 'Create Symlinks' button clicked or ESC
		{
			// Build 'dests' & 'srcs' shell variables
			var dests = [];
			var srcs = [];

			for (var i = 0; i < dstFiles.length; i++)
			{
				dests.push('\"\"\"%1\"\"\"'.arg(dstFiles[i]));
				srcs.push('\"\"\"%1\"\"\"'.arg(srcFiles[i]));
			}

			dests = '$dests = @(%1)'.arg(dests.join(', ')); // $dests shell variable
			srcs = '$srcs = @(%1)'.arg(srcs.join(', ')); // $srcs shell variable

			// Build shell command (code adapted from @Omniflux)
			var cmd = "PowerShell.exe -NonInteractive -NoProfile -Command try { $p = Start-Process PowerShell.exe -Verb RunAs -Wait -WindowStyle Hidden -PassThru -ArgumentList".split(' ');
			cmd.push("'-NonInteractive -NoProfile -Command %1; %2; for ($i = 0; $i -lt $srcs.Count; $i++) {New-Item -ItemType SymbolicLink -Path $dests[$i] -Target $srcs[$i]}'".arg(dests).arg(srcs));
			cmd = cmd.concat("} catch { exit 1 } ; exit $p.ExitCode".split(' '));

			// Execute command
			var process = new DzProcess(cmd); // DzProcess

			if (process.start())
				while (process.running)
					processEvents();
		}
		else // 'Duplicate Files' button clicked
		{
			for (var i = 0; i < dstFiles.length; i++)
			{
				var file = new DzFile(srcFiles[i]); // Source file
				file.copy(dstFiles[i]); // Duplicate source file into destination
			}
		}
	}
	else // UNIX (MacOSX & Linux) : create symlinks
		for (var i = 0; i < dstFiles.length; i++)
			var file = new DzFile(srcFiles[i]).link(dstFiles[i]);

	assetMgr.updateFolderBasedContainers(); // Refresh pane
}

CreateSymlinks();

//=========================
// Get selected figure root node (DzNode)
//=========================
function getRootNode(oNode)
{
	if (!oNode || !oNode.isRootNode())
		return null;
	var inheritsType = typeof(oNode.inherits) == 'function' && oNode.inherits('DzBone'); // Check if node is a bone
	return inheritsType ? oNode.getSkeleton() : oNode; // Return the skeleton if node is a bone, otherwise return the original node
}

// Get selected node in the Scene
var oNode = getRootNode(Scene.getPrimarySelection());
if (!oNode || !oNode.getObject())
{
	MessageBox.critical('You must select a root figure to use this feature', 'Root figure not selected', '', '');
	return;
}

//=========================
// Collect attachment figures (Eyelashes, Mouth, Eyes, Tear, Eyebrow Cards)
//=========================
function GetAttachments()
{
	var out = [];

	var nodes = oNode.getNodeChildren();

	for (var i = 0; i < nodes.length; i++)
	{
		var n = nodes[i];
		if (n.inherits('DzFigure'))
			out.push(n);
	}
	return out;
}

