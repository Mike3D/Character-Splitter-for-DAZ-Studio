{
	// Create List View
	attachmentsLV = new DzListView(groupbox1_1); attachmentsLV.toolTip = 'Select attachment(s) for which you want to create a morph. Attachments with a morph applied are checked by default';
	layout1_1.addWidget(attachmentsLV, 3, 1);
	attachmentsLV.setFixedHeight(150);
	attachmentsLV.addColumn('Morphed Attachments');

	// Display figure label
	for (var i = 0; i < attachments.length; i++)
	{
		var item = new DzCheckListItem(attachmentsLV, DzCheckListItem.CheckBox, attachmentsLV.childCount);
		item.setText(0, attachments[i].getLabel());
		item.on = IsMorphed(attachments[i]); // Checked if a morph is applied
	}
}

//=========================
// Check if attachment is morphed (i.e. at least 1 morph is dialed-in)
//=========================
function IsMorphed(fig)
{
	var props = helper.getPropertiesOnNode(fig);

	for (var i = 0; i < props.length; i++)
	{
		var prop = props[i];

		if (helper.isMorphProperty(prop) && prop.getValue() !== prop.getDefaultValue()) // Dialed morph - Note: we have zeroed figures before processing
			return true;
	}
	return false;
}

