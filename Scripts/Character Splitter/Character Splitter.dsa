var window = new DzDialog(); window.caption = 'Character Splitter V4';
window.minWidth = 410;
var layout = new DzBoxLayout(window);

//==================
// Path Tree View
//==================

// Collect morphs paths
function GetMorphsPaths()
{
	var out = [];

	var props = helper.getPropertiesOnNode(oNode);

	for (var i = 0; i < props.length; i++)
	{
		var region = props[i].getRegion();

		if (region !== null && ['Actor', 'Head'].indexOf(region.name) >= 0) // Actor > Full Body, Actor > Head & Actor > People
			out.pushIfNotExists(props[i].getPath().slice(1)); // Note : with first slash removed
	}
	return out;
}

// Build Tree from paths
function BuildTree(paths)
{
	const out = {};

	paths.forEach(function(path) {
		var current = out;

		path.forEach(function(part) {
			if (!current[part])
				current[part] = {};
			current = current[part];
		});
	});

	return out;
}

// Insert an item in the Tree View
function InsertItem(parent, txt)
{
	var item = new DzListViewItem(parent);
	item.setText(0, txt);
	return item;
}

// Recursively insert items in the Tree View
function InsertItems(parent, key, data)
{
	var item = InsertItem(parent, key); // DzListViewItem

	if (typeof data === 'object' && !Array.isArray(data)) // Dict
	{
		Object.entries(data).forEach(function([k, v]) {
			InsertItems(item, k, v);
		});
	}
	else if (Array.isArray(data)) // Leaf array
	{
		for (var i = 0; i < data.length; i++)
			InsertItem(item, data[i]);
	}
}

// Reset tree view & display dialog
function ResetTreeView()
{
	treeView.sort(); // Note : sorting the tree view clears selection & collapses all items
	treeView.firstChild().open = true; // Expand root items
	pathDialog.show();
}

// On first click on a path button, initialize path browser
function InitializePathBrowser()
{
	// Get existing paths from installed morphs
	paths = GetMorphsPaths(); // [String] - eg. ['/Actor/People/Real World', ...]

	// Create dialog
	pathDialog = new DzBasicDialog();
	pathDialog.width = 250;
	pathDialog.height = 400;
	pathDialog.caption = 'Select Path';
	pathDialog.showHelpButton(false);
	pathDialog.showAcceptButton(false);
	pathDialog.showApplyButton(true); // Use 'Apply' button as we need to listen to the 'applyClicked' event

	// Initialize Tree View Widget
	treeView = new DzListView(window);
	treeView.minWidth = 200;
	treeView.minHeight = 450;
	treeView.addColumn('Path');
	treeView.setSorting(0, true); // Allow sorting

	// Populate Tree View
	const hierarchy = BuildTree(paths.map(function(x) { return x.split('/'); }));
	Object.entries(hierarchy).forEach(([k, v]) => {
		InsertItems(treeView, k, v);
	});

	// Add Tree View to dialog
	pathDialog.addWidget(treeView);
}

// Output selected path to LineEdit
function SelectPath(out)
{
	pathDialog.hide(); // Hide dialog

	// Get Tree View selection
	var sel = treeView.currentItem();
	if (!sel)
		return;

	// Convert selection to path by recursively climbing to its root
	var path = [sel.text(0)];
	while (sel.parent())
	{
		sel = sel.parent();
		path.push(sel.text(0));
	}
	out.text = path.reverse().join('/'); // Update path LineEdit
}

// Dialog for path selection
function PathDialog(out)
{
	// If not already done, initialize path browser setup
	if (!pathDialog)
		InitializePathBrowser();

	ResetTreeView(); // Display dialog

	connect(pathDialog, 'applyClicked', function() { SelectPath(out); });
}

