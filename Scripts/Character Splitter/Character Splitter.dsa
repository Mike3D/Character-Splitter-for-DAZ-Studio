var selection = []; // Selected attachment figures

var basePath = oNode.assetUri.toPath().replace(oNode.assetUri.filePath, ''); // Absolute path to Content Library for the selected figure

//=========================================  GUI  =========================================

//==================
// Helper Functions
//==================

function Label(parent, txt, width)
{
	var lab = new DzLabel(parent);
	lab.text = txt;
	if (width) lab.setFixedWidth(width);
	return lab;
}

function LineEdit(parent, tip='')
{
	var le = new DzLineEdit(parent);
	if (tip) le.placeholderText = tip;
	return le;
}

function LabelledLineEdit(parent, layout, row, labelTxt, width, tip)
{
	var label = Label(parent, labelTxt, width);
	if (layout)
		layout.addWidget(label, row, 0);

	var le = LineEdit(parent, tip);
	if (layout)
		layout.addWidget(le, row, 1);
	return le;
}

function Button(parent, txt = '', tip = '')
{
	var btn = new DzPushButton(parent);
	if (txt) btn.text = txt;
	if (tip) btn.toolTip = tip;
	return btn;
}

function CheckBox(parent, txt, checked, tip)
{
	var box = new DzCheckBox(parent);
	box.text = txt;
	box.checked = checked;
	if (tip) box.toolTip = tip;
	return box;
}

function ColorWidget(parent, layout, row, txt, width, color, tip)
{
	var label = Label(parent, txt, width);
	layout.addWidget(label, row, 0);

	var wgt = new DzColorWgt(parent);
	layout.addWidget(wgt, row, 1);
	wgt.value = color;
	wgt.toolTip = tip;
	return wgt;
}

function Slider(parent, layout, row, txt, width, value, sensitivity, asPercent, editable, tip, max=10)
{
	var label = Label(parent, txt, null);
	if (layout)
		layout.addWidget(label, row, 0);

	var wgt = new DzFloatSlider(parent);
	if (layout)
		layout.addWidget(wgt, row, 1);
	wgt.setFixedWidth(width);
	wgt.value = value;
	wgt.min = 0;
	wgt.max = max;
	wgt.clamped = true;
	wgt.sensitivity = sensitivity;
	wgt.displayAsPercent = asPercent;
	wgt.textEditable = editable;
	wgt.toolTip = tip;
	return wgt;
}

function VGroupBox(parent, title = '', hide = false)
{
	var box = new DzVGroupBox(parent);
	box.title = title;
	if (hide) box.hide();
	return box;
}

function PathBrowser(parent, layout, row, txt, width, sel)
{
	var le = LabelledLineEdit(parent, layout, row, txt, width);
	le.toolTip = 'Enter path for display in Shaping & Parameters panes, or click button to the right to use an already existing path';
	le.text = sel;

	var btn = Button(parent, '...', 'Browse to already existing paths from your installed morphs');
	if (layout)
		layout.addWidget(btn, row, 2);
	connect(btn, 'clicked', function() { PathDialog(le) });
	return le;
}

function CardSelect(parent, w=147, h=185)
{
	var gbox = new DzGroupBox(parent);
	gbox.title = 'Card Image';
	gbox.toolTip = 'Optional : browse to your image file (%1x%2 pixels transparent PNG, can be located anywhere). If left empty, you can later drop your PNG image files in your Product folder (hint: you can browse to it from last tab)'.arg(w).arg(h);

	var btn = Button(gbox, '...');
	btn.setFixedSize(w, h);
	btn.sizedFromIcon = true;
	connect(btn, 'clicked', function() { CardSelected(btn); });
	return btn;
}

function CardSelected(btn)
{
	// Open directory browser
	var file = FileDialog.doFileDialog(true, '', '', 'PNG File (*.png)'); // String (full file path)
	if (file.isEmpty()) return; // Cancelled by user

	// Display thumbnail & store selected file path in toolTip
	btn.text = '';
	btn.pixmap = new Pixmap(file);
	btn.iconSize = btn.pixmap.size;
	if (btn.width != btn.pixmap.size.width || btn.height != btn.pixmap.size.height)
		if (MessageBox.warning("Image size doesn't match specifications for :\n-> Head : 91x91 \n-> Body & CTRL : 147x185 \n-> Character Tip : 256x256 \n-> Character : 91x91", 'Warning', 'Doc', 'OK') == 0)
			App.showURL('https://docs.daz3d.com/public/software/dazstudio/4/userguide/creating_content/assembling/tutorials/custom_parameters/start');
	btn.toolTip = file;
}

